rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---- users ----
    match /users/{userId} {
      allow read, write: if true;
    }

    // ---- categories: public read, admin / authenticated write ----
    match /categories/{id} {
      allow read, write: if true;
    }

    // ---- promos ----
    match /promos/{id} {
      allow read, write: if true;
    }

    // ---- combos ----
    match /combos/{id} {
      allow read, write: if true;
    }

    // ---- courses ----
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- course_access: SECURE! Only verified purchasers, instructors, or admins can access ----
    match /course_access/{courseId} {
      allow read: if isSignedIn() && (
        exists(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + courseId)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/courses/$(courseId)) && get(/databases/$(database)/documents/courses/$(courseId)).data.creatorUserId == request.auth.uid)
      );
      allow write: if isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/courses/$(courseId)) && get(/databases/$(database)/documents/courses/$(courseId)).data.creatorUserId == request.auth.uid)
      );
    }

    // ---- purchases ----
    match /purchases/{purchaseId} {
      allow read, write: if isSignedIn();
    }

    // ---- transactions / payment_transactions ----
    match /transactions/{id} {
      allow read, write: if isSignedIn();
    }
    match /payment_transactions/{id} {
      allow read, write: if isSignedIn();
    }

    // ---- friends, friend requests & chats ----
    match /friend_requests/{id} {
      allow read, write: if isSignedIn();
    }
    match /friends/{id} {
      allow read, write: if isSignedIn();
    }
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // ---- notifications & reads ----
    match /notifications/{id} {
      allow read, write: if true;
    }
    match /notification_reads/{id} {
      allow read, write: if true;
    }

    // ---- social features ----
    match /course_likes/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /saved_courses/{id} {
      allow read, write: if isSignedIn();
    }
    match /course_comments/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /course_reviews/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /course_reports/{id} {
      allow read, write: if isSignedIn();
    }
    match /report_messages/{id} {
      allow read, write: if isSignedIn();
    }
    match /course_views/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- ads & site settings & platform settings ----
    match /ads/{id} {
      allow read, write: if true;
    }
    match /site_settings/{id} {
      allow read, write: if true;
    }
    match /platformSettings/{id} {
      allow read, write: if true;
    }

    // ---- login market ----
    match /login_products/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /login_products_secrets/{id} {
      allow read, write: if isSignedIn();
    }

    // ---- broadcasts ----
    match /broadcasts/{id} {
      allow read, write: if true;
    }

    // ---- polls & votes ----
    match /polls/{id} {
      allow read, write: if true;
    }
    match /poll_votes/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
