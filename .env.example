# Copy this file to .env and fill in your values
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config
# Expo automatically loads any variable prefixed EXPO_PUBLIC_ into the app.

EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Base URL of your deployed Cloud Functions (after `firebase deploy --only functions`)
EXPO_PUBLIC_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=your_telegram_bot_username
